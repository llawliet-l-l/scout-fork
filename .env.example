# Copy to .env.local for local development and fill in the keys.
# No variable here uses the NEXT_PUBLIC_ prefix: these are server-side only.

# Provider keys (required once the benchmark calls the providers).
RANGO_API_KEY=
REFERENCE_PROVIDER_API_KEY=

# Optional. Defaults to https://api.rango.exchange; set it only to point at another environment.
# RANGO_API_BASE_URL=
